root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{yml,yaml,md,nix}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true

[{target,.direnv,.worktrees}/**]
ignore = true
