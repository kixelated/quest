{
	"name": "quest",
	"version": "0.1.0",
	"description": "Versioned Markdown quests: validate plans, find ready work, and name the branches a quest lands on.",
	"license": "MIT OR Apache-2.0",
	"author": "Luke Curley",
	"repository": "github:moq-dev/quest",
	"private": true,
	"type": "module",
	"workspaces": [
		"cloudflare"
	],
	"exports": {
		"./core": "./src/core/index.ts"
	},
	"bin": {
		"quest": "dist/quest.js"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"build": "bun build src/cli/bin.ts --target=bun --banner \"#!/usr/bin/env bun\" --outfile dist/quest.js && bun scripts/executable.mjs dist/quest.js",
		"compile": "bun build src/cli/bin.ts --compile --outfile dist/quest",
		"quest": "bun src/cli/bin.ts",
		"check": "tsc && tsc -p src/core && prettier --check .",
		"test": "vitest run",
		"fix": "prettier --write ."
	},
	"dependencies": {
		"@opencode-ai/sdk": "1.19.0",
		"commander": "15.0.0",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-gfm-strikethrough": "2.0.1",
		"mdast-util-gfm-table": "2.0.0",
		"micromark-extension-gfm-strikethrough": "2.1.0",
		"micromark-extension-gfm-table": "2.1.2"
	},
	"devDependencies": {
		"@types/mdast": "4.0.4",
		"@types/node": "26.6.5",
		"prettier": "3.9.10",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"trustedDependencies": []
}
