{
	"name": "quest-cloudflare",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"build": "bun scripts/build.ts",
		"check": "bun run build && wrangler types --check && tsc --noEmit && prettier --check . && wrangler deploy --dry-run",
