	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.2",
		"@types/node": "26.6.4",
		"prettier": "3.9.9",
		"typescript": "7.0.2",
		"vitest": "5.0.3",
		"wrangler": "4.151.0"
	}
