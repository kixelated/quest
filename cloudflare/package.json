{
	"name": "quest-cloudflare",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"check": "wrangler types --check && tsc --noEmit && prettier --check . && wrangler deploy --dry-run",
		"test": "vitest run",
		"fix": "prettier --write .",
		"types": "wrangler types",
		"migrate": "wrangler d1 migrations apply DB --local",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"better-auth": "1.7.7",
		"hono": "4.13.12"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.3.5",
		"@types/node": "26.6.4",
		"jsonc-parser": "3.3.1",
		"prettier": "3.9.9",
		"typescript": "7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.146.0"
	}
}
