{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "quest-cloudflare",
	"main": "src/index.tsx",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Renders docs/*.md, snapshots quest/ for the board, and stages the theme and site.css into build/.
	"build": {
		"command": "bun scripts/build.ts",
		"watch_dir": ["src", "scripts", "../docs", "../design", "../quest"],
	},
	"assets": { "directory": "build/public" },
	"routes": [{ "pattern": "kix.quest", "custom_domain": true }],
	"workers_dev": false,
	"vars": { "AUTH_URL": "https://kix.quest", "GITHUB_APP_ID": "", "GITHUB_FORK_OWNER": "" },
	"secrets": {
		"required": [
			"AUTH_SECRET",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"GITHUB_APP_PRIVATE_KEY",
			"GITHUB_WEBHOOK_SECRET",
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quest-auth",
			"database_id": "67aac614-20eb-4426-a501-6043238f486c",
			"migrations_dir": "migrations",
		},
	],
	// Deletes the legacy RepositoryCoordinator namespace and its storage if an earlier deploy
	// provisioned it; a no-op otherwise. Remove this tombstone once every deploy has applied it.
	"exports": { "RepositoryCoordinator": { "type": "durable-object", "state": "deleted" } },
}
