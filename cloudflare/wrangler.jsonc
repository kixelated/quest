{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "quest-cloudflare",
	"main": "src/index.tsx",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Renders docs/*.md and stages the theme and site.css into build/.
	"build": { "command": "node scripts/build.ts", "watch_dir": ["src", "scripts", "../docs"] },
	"assets": { "directory": "build/public" },
	"routes": [{ "pattern": "kixel.quest", "custom_domain": true }],
	"workers_dev": false,
	"vars": { "AUTH_URL": "https://kixel.quest" },
	"secrets": { "required": ["AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"] },
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "quest" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quest-auth",
			"database_id": "67aac614-20eb-4426-a501-6043238f486c",
			"migrations_dir": "migrations",
		},
	],
	"durable_objects": { "bindings": [{ "name": "REPOSITORIES", "class_name": "RepositoryCoordinator" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepositoryCoordinator"] }],
}
