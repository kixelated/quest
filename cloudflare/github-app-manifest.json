{
	"name": "Quest",
	"url": "https://kix.quest",
	"description": "Versioned quest plans and explicitly approved GitHub operations.",
	"public": true,
	"hook_attributes": {
		"url": "https://kix.quest/webhooks/github",
		"active": true
	},
	"default_permissions": {
		"metadata": "read",
		"contents": "write",
		"issues": "write",
		"pull_requests": "write",
		"checks": "read",
		"statuses": "read",
		"email_addresses": "read"
	},
	"default_events": [
		"push",
		"issues",
		"issue_comment",
		"pull_request",
		"pull_request_review",
		"pull_request_review_thread",
		"pull_request_review_comment",
		"check_run",
		"check_suite",
		"status"
	],
	"callback_urls": ["https://kix.quest/api/auth/callback/github"],
	"request_oauth_on_install": true
}
