# Generate a random secret with `openssl rand -hex 32`; replace these placeholders.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GITHUB_CLIENT_ID=replace-with-github-app-client-id
GITHUB_CLIENT_SECRET=replace-with-github-app-client-secret
# Optional Google sign-in, offered only when both are set. Wrangler dev loads
# the secret only while it is listed in wrangler.jsonc's `secrets.required`.
# GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Local development serves the app from Wrangler instead of https://kix.quest.
AUTH_URL=http://localhost:8787

# Server-only GitHub App integration; see GITHUB.md. Separate from OAuth login.
GITHUB_APP_ID=replace-with-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-quoted-PEM-private-key
GITHUB_WEBHOOK_SECRET=replace-with-random-webhook-secret

# Optional decision notifications: `bun scripts/vapid.ts` prints a key pair.
# Set VAPID_PUBLIC_KEY here, and list VAPID_PRIVATE_KEY under
# `secrets.required` in wrangler.jsonc while trying it, as with Google.
# VAPID_PUBLIC_KEY=replace-with-vapid-public-key
# VAPID_PRIVATE_KEY=replace-with-vapid-private-key
